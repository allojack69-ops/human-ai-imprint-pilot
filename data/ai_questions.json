      {
        "id": "A",
        "text": "The fifth machine is probably defective",
        "v": {
          "state_dependence": -1
        }
      },
      {
        "id": "B",
        "text": "Check what differs about that room before blaming the machine",
        "v": {
          "state_dependence": 1,
          "info_value": 0.5
        }
      },
      {
        "id": "C",
        "text": "Normalize its output to the others",
        "v": {
          "state_dependence": -0.7
        }
      }
    ]
  },
